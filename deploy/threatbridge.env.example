# Copy to deploy/threatbridge.env, chmod 600. Do not commit the real file.
TB_BACKEND=elastic
TB_ES_URL=https://localhost:9200
TB_ES_USER=CHANGE_ME
TB_ES_PASS=CHANGE_ME
# CA that signed Elasticsearch's cert, as mounted inside the container.
TB_ES_CA=/so-ca/ca.crt
TB_ES_INDEX=logs-*
TB_DATASETS=conn,zeek.conn
# Where "Filter SOC Dashboards" links point (the SOC URL analysts use).
TB_SOC_URL=https://securityonion.example.internal
TB_WINDOW=24h
TB_LIMIT=50
TB_RARE_SCAN_CAP=10000
